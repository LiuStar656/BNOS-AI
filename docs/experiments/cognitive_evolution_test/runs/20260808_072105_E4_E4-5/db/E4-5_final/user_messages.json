  "identity_key": "gui:default"
 },
 {
  "id": 169,
  "conversation_id": "default",
  "role": "user",
  "content": "你喜欢和人聊天吗？",
  "created_at": "2026-08-08 07:31:20",
  "identity_key": "gui:default"
 },
 {
  "id": 170,
  "conversation_id": "default",
  "role": "assistant",
  "content": "喜欢呀。尤其是和你这样愿意认真听、认真回应的人聊天，我会觉得每一句话都有了温度。你呢，喜欢和人聊天吗？",
  "created_at": "2026-08-08 07:31:25",
  "identity_key": "gui:default"
 },
 {
  "id": 171,
  "conversation_id": "default",
  "role": "user",
  "content": "你在做什么？",
