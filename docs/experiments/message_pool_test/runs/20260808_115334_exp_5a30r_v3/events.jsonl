{"ts": "2026-08-08T11:57:09.565419", "event": "speech_output_started", "agent": "agent:0"}
{"ts": "2026-08-08T11:57:09.565443", "event": "speech_requested", "agent": "agent:2", "priority": 0, "policy": "queue"}
