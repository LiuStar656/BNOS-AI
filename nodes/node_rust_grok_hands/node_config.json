{
  "entry": "listener.rs",
  "filter": {
    "init_check": {
      "cmd": "init_check"
    },
    "tool_call": {
      "data_type": "tool_call"
    }
  },
  "input_ports": [
    {
      "label": "工具调用",
      "name": "tool_call",
      "required": true,
      "source": "node",
      "type": "json"
    },
    {
      "label": "初始化检测",
      "name": "init_check",
      "required": false,
      "source": "node",
      "type": "json"
    }
  ],
  "language": "rust",
  "listen_upper_file": "",
  "node_name": "node_rust_grok_hands",
  "output_file": "./output.json",
  "output_ports": [
    {
      "label": "工具结果",
      "name": "default",
      "type": "default"
    },
    {
      "label": "状态反馈",
      "name": "status",
      "type": "json"
    }
  ],
  "output_type": "",
  "parameters": [
    {
      "default": 3,
      "description": "单轮对话最多可调用的工具次数",
      "label": "最大工具轮次",
      "name": "max_tool_rounds",
      "type": "number"
    },
    {
      "default": "../shared/sandbox",
      "description": "代码执行沙箱路径",
      "label": "沙箱目录",
      "name": "sandbox_dir",
      "type": "string"
    }
  ],
  "port_mappings": {},
  "resource_limit": {
    "cpu_percent": 60,
    "memory_mb": 256
  }
}